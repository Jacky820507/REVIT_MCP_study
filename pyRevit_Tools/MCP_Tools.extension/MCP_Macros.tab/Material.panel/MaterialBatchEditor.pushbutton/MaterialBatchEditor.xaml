<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="window"
        Title="材質批次編輯 — RevitMCP"
        Width="1280" Height="760" MinWidth="1080" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6F8"
        FontFamily="Segoe UI, Microsoft JhengHei"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#255783" />
        <SolidColorBrush x:Key="TableBrush" Color="#1F527D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D7E0E6" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFF8E6" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C7D3DC" />
            <Setter Property="Foreground" Value="#183B58" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="5,2,8,2" />
            <Setter Property="Padding" Value="5,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="5,2,8,2" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="BorderBrush" Value="#C7D3DC" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,3" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E9ED" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F7F9FA" />
            <Setter Property="RowHeight" Value="25" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource TableBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderBrush" Value="#497498" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#255783" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,8,0,5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandBrush}" Padding="16,9">
            <Grid>
                <StackPanel>
                    <TextBlock Text="材質批次編輯" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="先勾選材質、指定要套用的欄位，再預覽並確認寫入模型。"
                               Foreground="#DDEAF3" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#DDEAF3" Text="RevitMCP  ·  Controlled write" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,9">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="selectVisibleButton" Content="全選可見" />
                    <Button x:Name="clearCheckedButton" Content="清除勾選" />
                    <Button x:Name="refreshButton" Content="重新讀取" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="說明分類" VerticalAlignment="Center" />
                    <ComboBox x:Name="classCombo" Width="160" />
                    <TextBlock Text="搜尋" VerticalAlignment="Center" />
                    <TextBox x:Name="searchBox" Width="235" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#EAF0F4" Padding="10,7">
                        <DockPanel>
                            <TextBlock Text="專案材質庫" Foreground="#183B58" FontWeight="SemiBold" />
                            <TextBlock x:Name="checkedText" HorizontalAlignment="Right" Foreground="#536A7A" Text="已勾選 0 個" />
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="materialGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding [Checked], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="38" IsReadOnly="False" />
                            <DataGridTextColumn Header="材質名稱" Binding="{Binding [Name]}" Width="2.2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="說明分類" Binding="{Binding [Class]}" Width="1.1*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="顏色 RGB" Width="1.35*" IsReadOnly="True" SortMemberPath="Rgb">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                            <Border Width="34" Height="14" CornerRadius="1"
                                                    BorderBrush="#8795A1" BorderThickness="1"
                                                    Background="{Binding [RgbBrush]}" />
                                            <TextBlock Text="{Binding [Rgb]}" Margin="7,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="透明度" Binding="{Binding [Transparency]}" Width="0.65*" IsReadOnly="True" />
                            <DataGridTextColumn Header="使用數" Binding="{Binding [UsageCount]}" Width="0.65*" IsReadOnly="True" />
                            <DataGridTextColumn Header="類型參照" Binding="{Binding [TypeRefs]}" Width="0.75*" IsReadOnly="True" />
                            <DataGridTextColumn Header="材質 ID" Binding="{Binding [Id]}" Width="0.8*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Stretch" />

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TabControl x:Name="editorTabs" BorderThickness="0">
                    <TabItem Header="直接編輯">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,8,14,14">
                                <TextBlock Text="直接編輯目前選取材質" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="directSelectionHint"
                                           Text="請先在左側材質表點選一列。這裡只會編輯目前選取的單一材質。"
                                           Foreground="#536A7A" TextWrapping="Wrap" Margin="0,0,0,7" />

                                <TextBlock Text="識別資料" Style="{StaticResource SectionLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="82" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="名稱" VerticalAlignment="Center" Margin="5,0" />
                                    <TextBox x:Name="directNameBox" Grid.Column="1" />
                                    <TextBlock Text="說明分類" Grid.Row="1" VerticalAlignment="Center" Margin="5,0" />
                                    <TextBox x:Name="directClassBox" Grid.Row="1" Grid.Column="1" />
                                    <TextBlock Text="材質類別" Grid.Row="2" VerticalAlignment="Center" Margin="5,0" />
                                    <TextBox x:Name="directCategoryBox" Grid.Row="2" Grid.Column="1" />
                                    <TextBlock Text="描述" Grid.Row="3" VerticalAlignment="Top" Margin="5,9,5,0" />
                                    <TextBox x:Name="directDescriptionBox" Grid.Row="3" Grid.Column="1"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                </Grid>

                                <TextBlock Text="圖形資料" Style="{StaticResource SectionLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="顏色 RGB" VerticalAlignment="Center" Margin="5,0" />
                                    <Border x:Name="directColorSwatch" Grid.Column="1" Width="34" Height="20"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="#808080" BorderBrush="#8795A1" BorderThickness="1" />
                                    <TextBox x:Name="directColorBox" Grid.Column="2" />
                                    <TextBlock Text="透明度" Grid.Row="1" VerticalAlignment="Center" Margin="5,0" />
                                    <TextBox x:Name="directTransparencyBox" Grid.Row="1" Grid.Column="2" />
                                    <TextBlock Text="光澤度" Grid.Row="2" VerticalAlignment="Center" Margin="5,0" />
                                    <TextBox x:Name="directShininessBox" Grid.Row="2" Grid.Column="2" />
                                    <TextBlock Text="平滑度" Grid.Row="3" VerticalAlignment="Center" Margin="5,0" />
                                    <TextBox x:Name="directSmoothnessBox" Grid.Row="3" Grid.Column="2" />
                                    <TextBlock Text="表面前景色" Grid.Row="4" VerticalAlignment="Center" Margin="5,0" />
                                    <Border x:Name="directSurfaceColorSwatch" Grid.Row="4" Grid.Column="1" Width="34" Height="20"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="#000000" BorderBrush="#8795A1" BorderThickness="1" />
                                    <TextBox x:Name="directSurfaceColorBox" Grid.Row="4" Grid.Column="2" />
                                    <TextBlock Text="切割前景色" Grid.Row="5" VerticalAlignment="Center" Margin="5,0" />
                                    <Border x:Name="directCutColorSwatch" Grid.Row="5" Grid.Column="1" Width="34" Height="20"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="#000000" BorderBrush="#8795A1" BorderThickness="1" />
                                    <TextBox x:Name="directCutColorBox" Grid.Row="5" Grid.Column="2" />
                                </Grid>

                                <Button x:Name="directApplyButton" Content="預覽並套用目前選取"
                                        Style="{StaticResource ActionButton}" MinHeight="34" Margin="3,12,3,7" />
                                <Border Background="{StaticResource WarningBrush}" BorderBrush="#EFD99C" BorderThickness="1" Padding="9">
                                    <TextBlock TextWrapping="Wrap" Foreground="#765514"
                                               Text="套用前會先顯示差異並要求確認；外觀資產仍維持唯讀，不會被修改。" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="識別">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,8,14,14">
                                <TextBlock Text="名稱變更" Style="{StaticResource SectionLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="applyRename" Content="套用" />
                                    <ComboBox x:Name="renameModeCombo" Grid.Column="1" SelectedIndex="0">
                                        <ComboBoxItem Tag="none">名稱不改</ComboBoxItem>
                                        <ComboBoxItem Tag="prefix">加前綴</ComboBoxItem>
                                        <ComboBoxItem Tag="suffix">加後綴</ComboBoxItem>
                                        <ComboBoxItem Tag="replace">取代文字</ComboBoxItem>
                                    </ComboBox>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBox x:Name="renameValueBox" Width="125" ToolTip="前綴、後綴或尋找文字" />
                                        <TextBlock Text="→" VerticalAlignment="Center" />
                                        <TextBox x:Name="renameReplaceBox" Width="125" ToolTip="取代後文字；僅取代文字模式使用" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="前綴／後綴只使用左欄；取代文字使用左右兩欄。" Foreground="#6A7C89" Margin="5,2,0,6" />

                                <TextBlock Text="識別資料" Style="{StaticResource SectionLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="82" />
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="applyClass" Content="說明分類" />
                                    <TextBox x:Name="classBox" Grid.Column="1" />
                                    <CheckBox x:Name="applyCategory" Grid.Row="1" Content="材質類別" />
                                    <TextBox x:Name="categoryBox" Grid.Row="1" Grid.Column="1" />
                                    <CheckBox x:Name="applyDescription" Grid.Row="2" Content="描述" VerticalAlignment="Top" Margin="5,9" />
                                    <TextBox x:Name="descriptionBox" Grid.Row="2" Grid.Column="1"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="圖形">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,8,14,14">
                                <TextBlock Text="著色" Style="{StaticResource SectionLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="applyColor" Content="顏色 RGB" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="colorSwatch" Width="34" Height="20"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="#808080" BorderBrush="#8795A1" BorderThickness="1" />
                                        <TextBox x:Name="colorBox" Grid.Column="1" Text="128, 128, 128" />
                                    </Grid>
                                    <CheckBox x:Name="applyTransparency" Grid.Row="1" Content="透明度" />
                                    <TextBox x:Name="transparencyBox" Grid.Row="1" Grid.Column="1" Text="0" />
                                    <CheckBox x:Name="applyShininess" Grid.Row="2" Content="光澤度" />
                                    <TextBox x:Name="shininessBox" Grid.Row="2" Grid.Column="1" Text="0" />
                                    <CheckBox x:Name="applySmoothness" Grid.Row="3" Content="平滑度" />
                                    <TextBox x:Name="smoothnessBox" Grid.Row="3" Grid.Column="1" Text="0" />
                                    <CheckBox x:Name="applyUseRender" Grid.Row="4" Content="渲染外觀著色" />
                                    <CheckBox x:Name="useRenderBox" Grid.Row="4" Grid.Column="1" Content="使用渲染外觀色彩" />
                                </Grid>

                                <TextBlock Text="表面前景樣式" Style="{StaticResource SectionLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="applySurfacePattern" Content="填滿樣式" />
                                    <ComboBox x:Name="surfacePatternCombo" Grid.Column="1" />
                                    <CheckBox x:Name="applySurfaceColor" Grid.Row="1" Content="顏色 RGB" />
                                    <Grid Grid.Row="1" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="surfaceColorSwatch" Width="34" Height="20"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="#000000" BorderBrush="#8795A1" BorderThickness="1" />
                                        <TextBox x:Name="surfaceColorBox" Grid.Column="1" Text="0, 0, 0" />
                                    </Grid>
                                </Grid>

                                <TextBlock Text="切割前景樣式" Style="{StaticResource SectionLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="applyCutPattern" Content="填滿樣式" />
                                    <ComboBox x:Name="cutPatternCombo" Grid.Column="1" />
                                    <CheckBox x:Name="applyCutColor" Grid.Row="1" Content="顏色 RGB" />
                                    <Grid Grid.Row="1" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="cutColorSwatch" Width="34" Height="20"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="#000000" BorderBrush="#8795A1" BorderThickness="1" />
                                        <TextBox x:Name="cutColorBox" Grid.Column="1" Text="0, 0, 0" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="外觀">
                        <StackPanel Margin="16">
                            <TextBlock Text="渲染外觀資產（唯讀）" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="目前材質" Foreground="#6A7C89" />
                            <TextBox x:Name="selectedMaterialBox" IsReadOnly="True" Margin="0,4,0,12" />
                            <TextBlock Text="外觀資產名稱" Foreground="#6A7C89" />
                            <TextBox x:Name="assetNameBox" IsReadOnly="True" Margin="0,4,0,12" />
                            <Border Background="{StaticResource WarningBrush}" BorderBrush="#EFD99C" BorderThickness="1" Padding="10">
                                <TextBlock TextWrapping="Wrap" Foreground="#765514"
                                           Text="此外觀資產可能由多個材質共用。本工具不批次修改、複製或替換 Appearance Asset，避免連帶改變其他材質。" />
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="10,0,10,0" Padding="10,7" Background="{StaticResource WarningBrush}"
                BorderBrush="#EFD99C" BorderThickness="1">
            <TextBlock x:Name="previewText" Foreground="#765514" TextWrapping="Wrap"
                       Text="尚未預覽。只有勾選「套用」的欄位會寫入；本工具不新增、複製或刪除材質。" />
        </Border>

        <Border Grid.Row="4" Background="#EAF0F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="statusText" VerticalAlignment="Center" Foreground="#536A7A" Text="正在讀取材質…" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="previewButton" Content="預覽變更" />
                    <Button x:Name="applyButton" Content="套用變更" Style="{StaticResource ActionButton}" MinWidth="100" />
                    <Button x:Name="closeButton" Content="關閉" MinWidth="86" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
