<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="window"
        Title="材質反查 — RevitMCP"
        Width="1280" Height="760" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6F8"
        FontFamily="Segoe UI, Microsoft JhengHei"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#255783" />
        <SolidColorBrush x:Key="TableBrush" Color="#1F527D" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F3F6F8" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D7E0E6" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFF8E6" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C7D3DC" />
            <Setter Property="Foreground" Value="#183B58" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="4,0,10,0" />
            <Setter Property="Padding" Value="5,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="4,0,10,0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="BorderBrush" Value="#C7D3DC" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E9ED" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F7F9FA" />
            <Setter Property="RowHeight" Value="25" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource TableBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderBrush" Value="#497498" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandBrush}" Padding="16,9">
            <Grid>
                <StackPanel>
                    <TextBlock Text="材質反查" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="從材質找到實際使用元素、Paint 來源與面積；本工具唯讀，不修改模型。"
                               Foreground="#DDEAF3" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#DDEAF3" Text="RevitMCP  ·  Material audit" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,9">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="範圍" VerticalAlignment="Center" />
                    <ComboBox x:Name="scopeCombo" Width="118" SelectedIndex="0">
                        <ComboBoxItem Tag="project">整個專案</ComboBoxItem>
                        <ComboBoxItem Tag="view">目前視圖</ComboBoxItem>
                        <ComboBoxItem Tag="selection">目前選取</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="使用狀態" VerticalAlignment="Center" />
                    <ComboBox x:Name="usedCombo" Width="112" SelectedIndex="0">
                        <ComboBoxItem Tag="all">全部</ComboBoxItem>
                        <ComboBoxItem Tag="used">使用中</ComboBoxItem>
                        <ComboBoxItem Tag="unused">未使用</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="說明分類" VerticalAlignment="Center" />
                    <ComboBox x:Name="classCombo" Width="145" SelectedIndex="0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="搜尋" VerticalAlignment="Center" />
                    <TextBox x:Name="searchBox" Width="205" />
                    <Button x:Name="refreshButton" Content="重新讀取" />
                    <Button x:Name="exportButton" Content="匯出 Excel" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#EAF0F4" Padding="10,7">
                        <TextBlock Text="專案材質庫" Foreground="#183B58" FontWeight="SemiBold" />
                    </Border>
                    <DataGrid x:Name="materialGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="材質名稱" Binding="{Binding [Name]}" Width="2.1*" />
                            <DataGridTextColumn Header="說明分類" Binding="{Binding [Class]}" Width="1.2*" />
                            <DataGridTemplateColumn Header="顏色 RGB" Width="1.35*" SortMemberPath="Rgb">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                            <Border Width="34" Height="14" CornerRadius="1"
                                                    BorderBrush="#8795A1" BorderThickness="1"
                                                    Background="{Binding [RgbBrush]}" />
                                            <TextBlock Text="{Binding [Rgb]}" Margin="7,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="透明度" Binding="{Binding [Transparency]}" Width="0.7*" />
                            <DataGridTextColumn Header="使用元素" Binding="{Binding [UsageCount]}" Width="0.85*" />
                            <DataGridTextColumn Header="Paint" Binding="{Binding [PaintCount]}" Width="0.65*" />
                            <DataGridTextColumn Header="材質 ID" Binding="{Binding [Id]}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Stretch" />
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#EAF0F4" Padding="10,7">
                        <TextBlock x:Name="usageTitle" Text="使用元素 — 請選取一個材質" Foreground="#183B58" FontWeight="SemiBold" />
                    </Border>
                    <DataGrid x:Name="usageGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="類別" Binding="{Binding [Category]}" Width="1.1*" />
                            <DataGridTextColumn Header="元素" Binding="{Binding [Element]}" Width="1.4*" />
                            <DataGridTextColumn Header="類型" Binding="{Binding [Type]}" Width="1.1*" />
                            <DataGridTextColumn Header="樓層" Binding="{Binding [Level]}" Width="0.8*" />
                            <DataGridTextColumn Header="來源" Binding="{Binding [Source]}" Width="0.8*" />
                            <DataGridTextColumn Header="面積 m²" Binding="{Binding [Area], StringFormat=N3}" Width="0.8*" />
                            <DataGridTextColumn Header="元素 ID" Binding="{Binding [Id]}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="10,0,10,0" Padding="10,7" Background="{StaticResource WarningBrush}"
                BorderBrush="#EFD99C" BorderThickness="1">
            <TextBlock x:Name="warningText" Foreground="#765514" TextWrapping="Wrap"
                       Text="提示：材質使用量包含幾何材質、Paint 與類型參照；「掃描未發現」不等於可安全刪除。" />
        </Border>

        <Border Grid.Row="4" Background="#EAF0F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="statusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="#536A7A" Text="尚未掃描。" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="selectButton" Content="選取元素" />
                    <Button x:Name="showButton" Content="亮顯元素" Style="{StaticResource ActionButton}" />
                    <Button x:Name="closeButton" Content="關閉" MinWidth="86" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
