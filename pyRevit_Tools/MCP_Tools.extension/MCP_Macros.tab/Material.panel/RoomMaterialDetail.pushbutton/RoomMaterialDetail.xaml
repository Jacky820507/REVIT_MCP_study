<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="window"
        Title="房間材質明細 — RevitMCP"
        Width="1280" Height="760" MinWidth="1080" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6F8"
        FontFamily="Segoe UI, Microsoft JhengHei"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#255783" />
        <SolidColorBrush x:Key="TableBrush" Color="#1F527D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D7E0E6" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFF8E6" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="13,4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C7D3DC" />
            <Setter Property="Foreground" Value="#183B58" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="5,1,12,1" />
            <Setter Property="Padding" Value="5,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="5,1,10,1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="BorderBrush" Value="#C7D3DC" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E9ED" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F7F9FA" />
            <Setter Property="RowHeight" Value="25" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="True" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource TableBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderBrush" Value="#497498" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandBrush}" Padding="16,9">
            <Grid>
                <StackPanel>
                    <TextBlock Text="房間材質明細" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="依房間邊界整理地面、牆面、上界與其他材質，並保留來源元素供複核。"
                               Foreground="#DDEAF3" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#DDEAF3" Text="RevitMCP  ·  Room finish audit" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="計算範圍" VerticalAlignment="Center" />
                        <ComboBox x:Name="scopeCombo" Width="135" SelectedIndex="0">
                            <ComboBoxItem Tag="all">專案全部房間</ComboBoxItem>
                            <ComboBoxItem Tag="selection">目前選取房間</ComboBoxItem>
                            <ComboBoxItem Tag="view">目前視圖房間</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="邊界位置" VerticalAlignment="Center" />
                        <ComboBox x:Name="boundaryCombo" Width="165" SelectedIndex="0">
                            <ComboBoxItem Tag="finish">面層 Finish</ComboBoxItem>
                            <ComboBoxItem Tag="center">中心線 Center</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="表面" VerticalAlignment="Center" />
                        <CheckBox x:Name="floorCheck" Content="地面" IsChecked="True" />
                        <CheckBox x:Name="wallCheck" Content="牆面" IsChecked="True" />
                        <CheckBox x:Name="ceilingCheck" Content="天花／上界" IsChecked="True" />
                        <CheckBox x:Name="otherCheck" Content="其他" />
                    </StackPanel>
                    <Button x:Name="calculateButton" DockPanel.Dock="Right" Content="開始計算" Style="{StaticResource ActionButton}"
                            HorizontalAlignment="Right" MinWidth="108" />
                </DockPanel>
                <DockPanel Grid.Row="1" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="檢視" VerticalAlignment="Center" />
                        <ComboBox x:Name="viewCombo" Width="145" SelectedIndex="0">
                            <ComboBoxItem Tag="detail">逐房間明細</ComboBoxItem>
                            <ComboBoxItem Tag="rooms">依房間彙總</ComboBoxItem>
                            <ComboBoxItem Tag="materials">依材質彙總</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="搜尋" VerticalAlignment="Center" />
                        <TextBox x:Name="searchBox" Width="220" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="showElementsButton" Content="亮顯邊界元素" />
                        <Button x:Name="showRoomsButton" Content="亮顯房間" />
                        <Button x:Name="showSkippedButton" Content="略過的房間…" />
                        <Button x:Name="exportButton" Content="匯出 Excel" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="10" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#EAF0F4" Padding="10,7">
                    <DockPanel>
                        <TextBlock x:Name="tableTitle" Text="逐房間明細" Foreground="#183B58" FontWeight="SemiBold" />
                        <TextBlock x:Name="rowCountText" HorizontalAlignment="Right" Foreground="#536A7A" Text="0 列" />
                    </DockPanel>
                </Border>
                <DataGrid x:Name="resultGrid" Grid.Row="1" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="10,0,10,0" Padding="10,7" Background="{StaticResource WarningBrush}"
                BorderBrush="#EFD99C" BorderThickness="1">
            <TextBlock x:Name="warningText" Foreground="#765514" TextWrapping="Wrap"
                       Text="注意：天花是房間上界，不必然是 Ceiling 元素；請用「來源／方法」與亮顯邊界元素複核。" />
        </Border>

        <Border Grid.Row="4" Background="#EAF0F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="statusText" VerticalAlignment="Center" Foreground="#536A7A" Text="尚未計算。" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="totalAreaText" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="#183B58" Margin="0,0,18,0" Text="顯示合計 0.000 m²" />
                    <Button x:Name="closeButton" Content="關閉" MinWidth="86" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
