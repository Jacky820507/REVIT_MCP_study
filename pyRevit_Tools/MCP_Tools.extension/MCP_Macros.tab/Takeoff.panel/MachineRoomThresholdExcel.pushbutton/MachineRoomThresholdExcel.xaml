<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="不鏽鋼門檻（機房）Excel" Height="900" Width="900"
    WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="280"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="105"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,5,8,12" Text="Excel 路徑"/>
    <TextBox x:Name="pathBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,12"
             MinWidth="480" VerticalContentAlignment="Center"/>
    <Button x:Name="browseButton" Grid.Row="0" Grid.Column="2" Margin="0,0,8,12"
            Padding="14,5" Content="瀏覽…"/>
    <Button x:Name="loadButton" Grid.Row="0" Grid.Column="3" Margin="0,0,0,12"
            Padding="14,5" Content="載入"/>

    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,8,12" Text="門檻儲存格"/>
    <TextBlock x:Name="targetText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
               Margin="0,5,0,12" Foreground="#666"
               Text="—（選 Excel 後自動定位「不銹鋼門檻機房」格）"
               TextTrimming="CharacterEllipsis"/>

    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,8,12" Text="加總依據"/>
    <ComboBox x:Name="indexBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
              Margin="0,0,0,12" MinHeight="24"
              VerticalContentAlignment="Center"/>

    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,5,8,12" Text="連結模型"/>
    <TextBlock x:Name="linkSummaryText" Grid.Row="3" Grid.Column="1"
               Margin="0,5,8,12" Foreground="#666" Text="未選取（只讀主模型房間）"
               TextTrimming="CharacterEllipsis"/>
    <Button x:Name="selectLinksButton" Grid.Row="3" Grid.Column="2"
            Grid.ColumnSpan="2" Margin="0,0,0,12" Padding="14,5"
            Content="選擇連結模型…"/>

    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,5,8,12" Text="樓層"/>
    <TextBlock x:Name="levelSummaryText" Grid.Row="4" Grid.Column="1"
               Margin="0,5,8,12" Foreground="#666"
               Text="未篩選（每個模型都抓全部樓層）"
               TextTrimming="CharacterEllipsis"/>
    <Button x:Name="selectLevelsButton" Grid.Row="4" Grid.Column="2"
            Grid.ColumnSpan="2" Margin="0,0,0,12" Padding="14,5"
            Content="選擇樓層…"/>

    <GroupBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
              Header="Revit 機房房間（預設勾選機房，可自行增減）">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock DockPanel.Dock="Left" Margin="0,5,6,0" Text="篩選"/>
          <Button x:Name="selectDefaultButton" DockPanel.Dock="Right"
                  Margin="6,0,0,0" Padding="10,3" Content="只選機房"/>
          <Button x:Name="clearAllButton" DockPanel.Dock="Right"
                  Margin="6,0,0,0" Padding="10,3" Content="全不選"/>
          <Button x:Name="selectAllButton" DockPanel.Dock="Right"
                  Margin="6,0,0,0" Padding="10,3" Content="全選"/>
          <TextBox x:Name="filterBox" VerticalContentAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="roomCountText" DockPanel.Dock="Bottom"
                   Margin="0,6,0,0" Foreground="#666" Text="—"/>
        <TextBlock x:Name="scopeText" DockPanel.Dock="Bottom"
                   Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"
                   Text="—"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="roomPanel"/>
        </ScrollViewer>
      </DockPanel>
    </GroupBox>

    <Button x:Name="previewButton" Grid.Row="6" Grid.Column="3"
            Margin="0,12,0,12" Padding="18,6" Content="產生預覽"/>

    <GroupBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Header="Dry-run 預覽">
      <TextBox x:Name="previewBox" Margin="8" IsReadOnly="True"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               TextWrapping="NoWrap" FontFamily="Consolas"/>
    </GroupBox>

    <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4"
                Margin="0,14,0,0" Orientation="Horizontal"
                HorizontalAlignment="Right">
      <TextBlock x:Name="statusText" Margin="0,7,16,0" Foreground="#666"
                 Text="請先選 Excel 並載入。"/>
      <Button x:Name="updateButton" IsEnabled="False" MinWidth="110"
              Margin="0,0,8,0" Padding="14,6" Content="更新 Excel"/>
      <Button x:Name="cancelButton" MinWidth="80" Padding="14,6" Content="取消"/>
    </StackPanel>
  </Grid>
</Window>
