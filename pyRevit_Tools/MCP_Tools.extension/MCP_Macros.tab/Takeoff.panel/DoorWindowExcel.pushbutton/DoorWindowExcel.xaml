<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="門窗表 Excel" Height="720" Width="800"
    WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="115"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,5,8,12" Text="Excel 路徑"/>
    <TextBox x:Name="pathBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,12"
             MinWidth="420" VerticalContentAlignment="Center"/>
    <Button x:Name="browseButton" Grid.Row="0" Grid.Column="2" Margin="0,0,0,12"
            Padding="14,5" Content="瀏覽…"/>

    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,8,12" Text="資料來源模式"/>
    <ComboBox x:Name="sourceModeCombo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
              Margin="0,0,0,12" MinHeight="27">
      <ComboBoxItem Content="自動偵測全專案門與窗" IsSelected="True"/>
      <ComboBoxItem Content="使用下方選取的明細表"/>
    </ComboBox>

    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,8,12" Text="連結模型"/>
    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="linkSummaryText" Grid.Column="0" Margin="0,5,8,0"
                 Foreground="#666" Text="未選取連結模型（只計算主模型）"
                 TextTrimming="CharacterEllipsis"/>
      <Button x:Name="selectLinksButton" Grid.Column="1" Padding="14,5"
              Content="選擇連結模型…"/>
    </Grid>

    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,5,8,12" Text="門窗明細表"/>
    <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock x:Name="scheduleSummaryText" Margin="0,4,0,0"
                   Foreground="#666" Text="自動模式不使用明細表"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="scheduleHintText" Margin="0,3,0,0" Foreground="#777"
                   FontSize="11"
                   Text="明細表模式只統計選取表內列出的元素；連結模型一律另外計入。"/>
      </StackPanel>
      <Button x:Name="selectSchedulesButton" Grid.Column="1" Padding="14,5"
              Content="選擇明細表…"/>
    </Grid>

    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,5,8,12" Text="樓層篩選"/>
    <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock x:Name="levelSummaryText" Margin="0,4,0,0"
                   Foreground="#666" Text="未篩選（全部樓層都抓）"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="levelHintText" Margin="0,3,0,0" Foreground="#777"
                   FontSize="11"
                   Text="不勾選＝全抓。清單會列出主模型與已選連結模型各自的樓層。"/>
      </StackPanel>
      <Button x:Name="selectLevelsButton" Grid.Column="1" Padding="14,5"
              Content="選擇樓層…"/>
    </Grid>

    <Button x:Name="previewButton" Grid.Row="5" Grid.Column="2"
            Margin="0,0,0,12" Padding="18,6" Content="產生預覽"/>

    <GroupBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
              Header="Dry-run 預覽（小計 → 金屬門窗工程）">
      <TextBox x:Name="previewBox" Margin="8" IsReadOnly="True"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               TextWrapping="NoWrap" FontFamily="Consolas"/>
    </GroupBox>

    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                Margin="0,14,0,0" Orientation="Horizontal"
                HorizontalAlignment="Right">
      <TextBlock x:Name="statusText" Margin="0,7,16,0" Foreground="#666"
                 Text="請先選 Excel 並產生預覽。"/>
      <Button x:Name="updateButton" IsEnabled="False" MinWidth="110"
              Margin="0,0,8,0" Padding="14,6" Content="更新 Excel"/>
      <Button x:Name="cancelButton" MinWidth="80" Padding="14,6" Content="取消"/>
    </StackPanel>
  </Grid>
</Window>
