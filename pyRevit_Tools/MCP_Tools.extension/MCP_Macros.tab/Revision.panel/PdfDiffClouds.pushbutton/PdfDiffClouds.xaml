<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="圖說差異 → 修訂雲"
    Width="1240" Height="820" MinWidth="1000" MinHeight="620"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Background="#F3F6F8"
    FontFamily="Segoe UI, Microsoft JhengHei"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True">

    <!-- 設計 token 集中在這裡。色票沿用專案既有的 #255783 品牌藍
         （material_tools_window.xaml），資訊層級與密度參考 linear.app：
         單一強調色只用在真正要緊的地方、四級文字灰階、髮絲邊框、小圓角。 -->
    <Window.Resources>
        <SolidColorBrush x:Key="Canvas"    Color="#F3F6F8" />
        <SolidColorBrush x:Key="Surface"   Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#F8FAFB" />
        <SolidColorBrush x:Key="Hairline"  Color="#E2E8ED" />
        <SolidColorBrush x:Key="HairlineStrong" Color="#CBD5DD" />
        <SolidColorBrush x:Key="Ink"       Color="#1B2733" />
        <SolidColorBrush x:Key="InkMuted"  Color="#5A6B7B" />
        <SolidColorBrush x:Key="InkSubtle" Color="#8A99A8" />
        <SolidColorBrush x:Key="Brand"     Color="#255783" />
        <SolidColorBrush x:Key="BrandDark" Color="#183B58" />
        <SolidColorBrush x:Key="OnBrand"   Color="#FFFFFF" />
        <SolidColorBrush x:Key="Success"   Color="#15803D" />
        <SolidColorBrush x:Key="Warning"   Color="#B45309" />
        <SolidColorBrush x:Key="Danger"    Color="#B91C1C" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkSubtle}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 次要按鈕：髮絲邊框，不搶主要動作的注意力 -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EEF3F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E1E9F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource InkSubtle}" />
                                <Setter TargetName="b" Property="Background" Value="#F1F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主要動作：整個視窗只有兩顆（開始比對、建立修訂雲） -->
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Foreground" Value="{StaticResource OnBrand}" />
            <Setter Property="Background" Value="{StaticResource Brand}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandDark}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2E6899" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrandDark}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#A8BCCD" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#A8BCCD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrong}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ① 標題列 -->
        <Border Grid.Row="0" Background="{StaticResource Brand}" Padding="20,12">
            <StackPanel>
                <TextBlock Text="圖說差異 → 修訂雲" Foreground="White"
                           FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="headerSub" Style="{StaticResource Caption}"
                           Foreground="#CFE0EE" Margin="0,3,0,0"
                           Text="選兩份向量 PDF：從圖框讀出圖號與圖名，對應到本專案圖紙，把差異圈成修訂雲。" />
            </StackPanel>
        </Border>

        <!-- ② 來源與比對 -->
        <Border Grid.Row="1" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="舊版 PDF"
                           Style="{StaticResource Caption}" Width="64"
                           VerticalAlignment="Center" Margin="0,0,10,6" />
                <TextBox x:Name="oldPathText" Grid.Row="0" Grid.Column="1"
                         Margin="0,0,8,6" IsReadOnly="True"
                         Text="尚未選擇" Foreground="#8A99A8" />
                <Button x:Name="pickOldButton" Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource Ghost}" Content="選檔…"
                        Width="74" Margin="0,0,8,6" Click="pick_old_clicked" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="新版 PDF"
                           Style="{StaticResource Caption}" Width="64"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="newPathText" Grid.Row="1" Grid.Column="1"
                         Margin="0,0,8,0" IsReadOnly="True"
                         Text="尚未選擇" Foreground="#8A99A8" />
                <Button x:Name="pickNewButton" Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource Ghost}" Content="選檔…"
                        Width="74" Margin="0,0,8,0" Click="pick_new_clicked" />

                <Button x:Name="compareButton" Grid.Row="0" Grid.Column="3"
                        Grid.RowSpan="2" Style="{StaticResource Primary}"
                        Content="開始比對" Width="120" Height="62"
                        IsEnabled="False" Click="compare_clicked" />

                <StackPanel Grid.Row="2" Grid.ColumnSpan="4"
                            Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="圈雲依據" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="modeCombo" Width="240" Margin="0,0,16,0"
                              SelectionChanged="filter_changed" />
                    <TextBlock Text="靈敏度" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="thresholdCombo" Width="210"
                              Margin="0,0,16,0" />
                    <CheckBox x:Name="hideOversizedCheck"
                              Content="隱藏過大區域（圈了等於沒圈）"
                              IsChecked="True" Margin="0,0,16,0"
                              Checked="filter_changed" Unchecked="filter_changed" />
                    <CheckBox x:Name="excludeTitleCheck"
                              Content="排除標題欄版次戳記" IsChecked="True" />
                    <CheckBox x:Name="removeOverlapCheck"
                              Content="清除本工具舊重疊雲" IsChecked="True"
                              Margin="16,0,12,0" />
                    <CheckBox x:Name="removeManualOverlapCheck"
                              Content="包含手動雲（危險）" IsChecked="False"
                              Foreground="{StaticResource Danger}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="4"
                            Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="雲所屬修訂" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="revisionCombo" Width="380"
                              ToolTip="選擇新雲要掛用的 Revit 修訂；未選擇時沿用最後修訂。" />
                    <TextBlock Text="　未選擇＝沿用最新修訂；沒有修訂時自動建立"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Margin="0,12,0,0">
                    <TextBlock Text="欲標圖紙（可複選；全部取消時視為全部）"
                               Style="{StaticResource Caption}" Margin="0,0,0,5" />
                    <Border Height="74" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource HairlineStrong}"
                            BorderThickness="1" CornerRadius="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="sheetFilterList" Margin="8,4" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="sheetFilterStatus"
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ③ 主區：左＝圖號對照，右＝差異區域 -->
        <Grid Grid.Row="2" Margin="20,14,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="PDF 圖號／圖名 → 本專案圖紙"
                       Style="{StaticResource SectionLabel}" />
            <TextBlock x:Name="detailLabel" Grid.Row="0" Grid.Column="2"
                       Text="差異區域" Style="{StaticResource SectionLabel}" />

            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="sheetList" Margin="0,4" />
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="regionList" Margin="12,8" />
                </ScrollViewer>
            </Border>
        </Grid>

         <!-- ④ 頁尾 -->
        <Border Grid.Row="3" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="statusText" Grid.Column="0"
                           Style="{StaticResource Caption}"
                           VerticalAlignment="Center"
                           Text="尚未比對。" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="selectAllButton" Style="{StaticResource Ghost}"
                            Content="全選目前顯示" Width="112" Margin="0,0,8,0"
                            Click="select_shown_clicked" />
                    <Button x:Name="clearAllButton" Style="{StaticResource Ghost}"
                            Content="全部取消" Width="88" Margin="0,0,16,0"
                            Click="clear_all_clicked" />
                    <Button x:Name="cancelButton" Style="{StaticResource Ghost}"
                            Content="關閉" Width="80" Margin="0,0,8,0"
                            Click="cancel_clicked" />
                    <Button x:Name="okButton" Style="{StaticResource Primary}"
                            Content="建立修訂雲" Width="120" IsEnabled="False"
                            Click="ok_clicked" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
