<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="無障礙樓梯數量檢核"
    Width="1120"
    Height="740"
    MinWidth="940"
    MinHeight="620"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Height" Value="26"/>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style TargetType="{x:Type Button}">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Foreground" Value="#42505C"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#B3261E" CornerRadius="3"
            Padding="14,10" Margin="0,0,0,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="closeButton" Content="關閉" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="無障礙樓梯數量檢核"
                     FontSize="21" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="documentText" Foreground="#F6E4E2" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Background="#FBF3F2" BorderBrush="#E7CFCC"
            BorderThickness="1" CornerRadius="4" Padding="13,10"
            Margin="0,0,0,10">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="#5B4340"
                   Text="建築技術規則建築設計施工編 §167-2：建築物設置之直通樓梯，至少應有一座為無障礙樓梯。"/>
        <CheckBox x:Name="appliesCheck" Margin="0,8,0,0" IsChecked="True"
                  Content="本棟適用第十章無障礙建築物規定（§167 但書所列之透天、公寓大廈專有部分、小型非公共建築物請取消勾選）"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#F5F7FA" BorderBrush="#D8E0EA"
            BorderThickness="1" CornerRadius="4" Padding="13,10"
            Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="260"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="分棟方式"
                   Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="buildingCombo" Grid.Row="0" Grid.Column="1"/>

        <TextBlock Grid.Row="0" Grid.Column="2" Text="避難層"
                   Style="{StaticResource FieldLabel}" Margin="20,0,10,0"/>
        <ComboBox x:Name="refugeCombo" Grid.Row="0" Grid.Column="3"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="無障礙標示參數"
                   Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="markerCombo" Grid.Row="1" Grid.Column="1"/>

        <TextBlock Grid.Row="1" Grid.Column="2" Text="代表無障礙的值"
                   Style="{StaticResource FieldLabel}" Margin="20,0,10,0"/>
        <ListBox x:Name="markerValueList" Grid.Row="1" Grid.Column="3"
                 SelectionMode="Multiple" Height="64" Margin="0,2"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="級高／級深規則"
                   Style="{StaticResource FieldLabel}" Margin="0,8,10,0"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                    Margin="0,8,0,0">
          <RadioButton x:Name="ruleGeneralRadio" IsChecked="True"
                       Content="規範 304.1 一般：級高 ≦16cm、級深 ≧26cm"/>
          <RadioButton x:Name="ruleApartmentRadio" Margin="0,4,0,0"
                       Content="規範 304.4 特別規定：第2層以上供住宅使用之公寓大廈，且各層樓地板面積 ≦240m²，級高 ≦18cm、級深 ≧24cm"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="樓梯合併容差 (mm)"
                   Style="{StaticResource FieldLabel}" Margin="0,8,10,0"/>
        <TextBox x:Name="toleranceText" Grid.Row="3" Grid.Column="1"
                 Margin="0,8,0,0"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                   Margin="20,8,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="#68737D" VerticalAlignment="Center"
                   Text="上下層樓梯水平距離小於此值才視為同一座；MultistoryStairs 群組不受此限。"/>
      </Grid>
    </Border>

    <TabControl Grid.Row="3">
      <TabItem Header="檢核結果">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="resultPanel" Margin="4,8,4,4"/>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="樓梯明細">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <StackPanel Margin="4,8,4,4">
            <Grid x:Name="detailHeader" Height="30" Background="#EAF2F8"/>
            <StackPanel x:Name="detailPanel"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="4" Margin="0,10,0,0" Padding="10,8"
            Background="#F8FAFC" BorderBrush="#D8E0EA"
            BorderThickness="1" CornerRadius="4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="statusText" Grid.Column="0" Foreground="#52606D"
                   TextWrapping="Wrap" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button x:Name="selectButton" Content="選取不符的樓梯" MinWidth="140"
                  IsEnabled="False"/>
          <Button x:Name="runButton" Content="執行檢核" MinWidth="120"
                  Background="#B3261E" Foreground="White"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
