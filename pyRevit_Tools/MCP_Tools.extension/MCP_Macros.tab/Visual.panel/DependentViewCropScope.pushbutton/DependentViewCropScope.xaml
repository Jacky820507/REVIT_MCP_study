<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="從屬視圖裁切"
    Width="940"
    Height="760"
    MinWidth="820"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="16,13" Margin="0,0,0,14"
            Background="#F3F6FA" BorderBrush="#D8E0EA" BorderThickness="1"
            CornerRadius="4">
      <StackPanel>
        <TextBlock FontSize="19" FontWeight="SemiBold"
                   Text="批次建立／重建從屬視圖"/>
        <TextBlock Margin="0,5,0,0" Foreground="#52606D" TextWrapping="Wrap"
                   Text="選一張裁切來源母圖，再複選要套用的目標母圖；也可改用網格線計算裁切範圍。全部設定完成後只需執行一次。"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="370"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <GroupBox Header="1. 裁切來源" Padding="12" Margin="0,0,0,12">
          <StackPanel>
            <RadioButton x:Name="sourceModeRadio" IsChecked="True"
                         Content="指定母圖的從屬視圖裁切模板"/>
            <RadioButton x:Name="gridModeRadio" Margin="0,8,0,0"
                         Content="依網格線計算 CropBox"/>

            <StackPanel x:Name="sourcePanel" Margin="0,14,0,0">
              <TextBlock Text="裁切來源母圖" Margin="0,0,0,5"/>
              <ComboBox x:Name="sourceCombo" MinHeight="29"/>
            <TextBlock x:Name="sourceHintText" Margin="0,5,0,0" FontSize="11" Foreground="#667788"
                       TextWrapping="Wrap"
                       Text="將複製來源母圖下的從屬視圖裁切模板。"/>
            </StackPanel>

            <StackPanel x:Name="gridPanel" Margin="0,14,0,0"
                        Visibility="Collapsed">
              <TextBlock Text="X 向網格名稱" Margin="0,0,0,5"/>
              <TextBox x:Name="xGridText" MinHeight="28"
                       VerticalContentAlignment="Center"/>
              <TextBlock Text="Y 向網格名稱" Margin="0,10,0,5"/>
              <TextBox x:Name="yGridText" MinHeight="28"
                       VerticalContentAlignment="Center"/>
              <TextBlock Text="邊界向外偏移（mm）" Margin="0,10,0,5"/>
              <TextBox x:Name="offsetText" Text="500" MinHeight="28"
                       VerticalContentAlignment="Center"/>
              <TextBlock x:Name="gridHintText" Margin="0,8,0,0"
                         FontSize="11" Foreground="#667788" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="3. 裁切控制" Padding="12">
          <StackPanel>
            <TextBlock Text="既有範圍框（選填）" Margin="0,0,0,5"/>
            <ComboBox x:Name="scopeBoxCombo" MinHeight="29"/>
            <TextBlock Margin="0,7,0,0" FontSize="11" Foreground="#667788"
                       TextWrapping="Wrap"
                       Text="未選範圍框時使用視圖自己的 CropBox。Revit 公開 API 無法從零建立新的範圍框，只能套用模型中既有的範圍框。"/>
          </StackPanel>
        </GroupBox>
      </StackPanel>

      <GroupBox Grid.Column="2" Header="2. 目標母圖（可複選）" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,6,7,0" Text="篩選"/>
            <TextBox x:Name="targetFilterBox" Grid.Column="1" MinHeight="29"
                     Margin="0,0,8,0" VerticalContentAlignment="Center"
                     ToolTip="輸入視圖名稱或樓層來篩選"/>
            <Button x:Name="selectAllButton" Grid.Column="2" MinWidth="76"
                    Margin="0,0,6,0" Padding="10,5" Content="全選顯示"/>
            <Button x:Name="clearTargetsButton" Grid.Column="3" MinWidth="62"
                    Padding="10,5" Content="清除"/>
          </Grid>

          <ListBox x:Name="targetList" Grid.Row="1"
                   SelectionMode="Multiple" BorderBrush="#B8C2CC"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

          <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="targetSummaryText" FontWeight="SemiBold"
                       Text="尚未選取目標母圖"/>
            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#667788"
                       TextWrapping="Wrap"
                       Text="直接點選即可複選，不需按 Ctrl；清單中的「既有」是該母圖目前的從屬視圖數。"/>
          </StackPanel>
        </Grid>
      </GroupBox>
    </Grid>

    <Border x:Name="rebuildPanel" Grid.Row="2" Margin="0,14,0,0"
            Padding="13,10" Background="#FFF8E6" BorderBrush="#E6C76A"
            BorderThickness="1" CornerRadius="4">
      <StackPanel>
        <TextBlock x:Name="rebuildTitleText" FontWeight="SemiBold"
                   Text="重跑策略：自動取代既有從屬視圖"/>
        <TextBlock x:Name="rebuildDetailText" Margin="0,4,0,0"
                   Foreground="#62501A" TextWrapping="Wrap"
                   Text="選取目標後，這裡會顯示即將清除與重建的數量。"/>
        <CheckBox x:Name="acknowledgeCheck" Margin="0,8,0,0"
                  Visibility="Collapsed" FontWeight="SemiBold"
                  Content="我了解既有從屬視圖與其圖紙視口可能被移除"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="statusText" Grid.Column="0" Margin="0,7,16,0"
                 Foreground="#B3261E" TextWrapping="Wrap"
                 Text="請選取至少一張目標母圖。"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="cancelButton" MinWidth="82" Margin="0,0,8,0"
                Padding="14,7" Content="取消"/>
        <Button x:Name="executeButton" MinWidth="170" Padding="14,7"
                IsDefault="True" IsEnabled="False"
                Content="建立／重建從屬視圖"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
