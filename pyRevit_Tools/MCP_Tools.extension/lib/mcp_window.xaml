<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="shell"
    Title="RevitMCP"
    Width="960" Height="700" MinWidth="820" MinHeight="560"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    Background="#F3F6F8"
    FontFamily="Microsoft JhengHei UI, Segoe UI, Microsoft JhengHei"
    FontSize="13"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

  <!--
    這是所有 MCP 巨集按鈕共用的唯一視窗外殼。

    共用一個檔案而不是每顆按鈕一份 XAML，是刻意的：本專案原本就有 14 個各自
    為政的 XAML、三種互不相干的視覺語彙、零共用資源字典。再加 18 份手寫檔案
    只會把漂移擴大，而不是解決它。欄位由 Python 依規格在 code-behind 建立
    （IronPython 的純物件不會發 INotifyPropertyChanged，因此不做 data binding）。

    色彩沿用本專案既有的深藍品牌（material_tools_window.xaml 的 #255783 家族），
    不另外引進一套新的視覺語言。
  -->

  <Window.Resources>

    <!-- ===== 色彩 token ===== -->
    <Color x:Key="BrandColor">#FF255783</Color>
    <SolidColorBrush x:Key="Brand" Color="#FF255783"/>
    <SolidColorBrush x:Key="BrandDark" Color="#FF183B58"/>
    <SolidColorBrush x:Key="BrandTint" Color="#FFE8F0F7"/>
    <SolidColorBrush x:Key="Canvas" Color="#FFF3F6F8"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#FF1B2733"/>
    <SolidColorBrush x:Key="Muted" Color="#FF64748B"/>
    <SolidColorBrush x:Key="Border" Color="#FFD7E0E6"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#FFA9BBC8"/>
    <SolidColorBrush x:Key="Success" Color="#FF15803D"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB45309"/>
    <SolidColorBrush x:Key="Danger" Color="#FFB91C1C"/>
    <SolidColorBrush x:Key="DangerTint" Color="#FFFDECEC"/>
    <SolidColorBrush x:Key="WarningTint" Color="#FFFDF5E7"/>
    <SolidColorBrush x:Key="DisabledFg" Color="#FF94A3B8"/>
    <SolidColorBrush x:Key="DisabledBg" Color="#FFEDF1F4"/>
    <SolidColorBrush x:Key="OnBrand" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="OnBrandMuted" Color="#FFC3D6E6"/>

    <!-- ===== 幾何 token ===== -->
    <Thickness x:Key="PadWindow">20</Thickness>
    <Thickness x:Key="PadCard">16</Thickness>
    <CornerRadius x:Key="RadiusControl">3</CornerRadius>
    <CornerRadius x:Key="RadiusCard">4</CornerRadius>

    <!-- ===== 文字階層 ===== -->
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource OnBrand}"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="Subtitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource OnBrandMuted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Help" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="LineHeight" Value="18"/>
    </Style>

    <!-- 欄位錯誤：紅字不是唯一訊號，訊息本身要說得出哪裡不對。 -->
    <Style x:Key="FieldError" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Danger}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas, Courier New"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <!-- ===== 輸入控制項 ===== -->
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="{StaticResource DisabledBg}"/>
          <Setter Property="Foreground" Value="{StaticResource DisabledFg}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 驗證失敗的輸入框：邊框加粗成紅色，配合下方的錯誤文字。 -->
    <Style x:Key="TextBoxError" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Background" Value="{StaticResource DangerTint}"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{StaticResource DisabledFg}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="6,0,0,0"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{StaticResource DisabledFg}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="6,0,0,0"/>
    </Style>

    <!-- ===== 按鈕 =====
         三種語意各一個 Style，因為「執行」與「刪除」不該長得一樣：
         會刪東西的動作必須在按下去之前就看得出來。 -->
    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
              </Trigger>
              <!-- 鍵盤焦點必須看得見，不能只靠滑鼠 hover。 -->
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush"
                        Value="{StaticResource BrandDark}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background"
                        Value="{StaticResource DisabledBg}"/>
                <Setter TargetName="bd" Property="BorderBrush"
                        Value="{StaticResource Border}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledFg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="Foreground" Value="{StaticResource OnBrand}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="{StaticResource Danger}"/>
      <Setter Property="Foreground" Value="{StaticResource OnBrand}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 清單上方的小動作（全選／全不選／只選 X），視覺重量要明顯低於主動作。 -->
    <Style x:Key="MicroButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Brand}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ===== 容器 ===== -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="ListFrame" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="20,8"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- 標題帶 -->
      <RowDefinition Height="*"/>      <!-- 內容 -->
      <RowDefinition Height="Auto"/>   <!-- 狀態列 -->
      <RowDefinition Height="Auto"/>   <!-- 動作列 -->
    </Grid.RowDefinitions>

    <!-- 標題帶：說明這顆按鈕在做什麼，以及它會不會動到模型 -->
    <Border Grid.Row="0" Background="{StaticResource BrandDark}" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock x:Name="titleText" Style="{StaticResource H1}" Text="RevitMCP"/>
          <TextBlock x:Name="subtitleText" Style="{StaticResource Subtitle}" Text=""/>
        </StackPanel>
        <Border x:Name="badgeBorder" Grid.Column="1" CornerRadius="3"
                Padding="10,4" VerticalAlignment="Top" Margin="16,0,0,0"
                Background="#33FFFFFF">
          <TextBlock x:Name="badgeText" Text="唯讀" FontSize="12"
                     Foreground="{StaticResource OnBrand}"/>
        </Border>
      </Grid>
    </Border>

    <!-- 內容：設定 / 結果 兩頁。結果頁在跑出結果之前是停用的。 -->
    <TabControl x:Name="tabs" Grid.Row="1" Margin="20,16,20,0"
                Background="Transparent" BorderThickness="0">
      <TabItem x:Name="settingsTab" Header="設定">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,12,0,0">
          <StackPanel x:Name="fieldHost"/>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="resultTab" Header="結果" IsEnabled="False">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel x:Name="summaryHost"/>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource ListFrame}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
              <Grid x:Name="resultGrid" Margin="0"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- 狀態列：長時間作業、驗證失敗與結果摘要都在這裡說話，
         不讓使用者對著一個沒有反應的視窗猜。 -->
    <Border Grid.Row="2" Margin="20,12,20,0" CornerRadius="3"
            Padding="12,8" Background="{StaticResource BrandTint}"
            BorderBrush="{StaticResource Border}" BorderThickness="1"
            Visibility="Collapsed" x:Name="statusBorder">
      <TextBlock x:Name="statusText" TextWrapping="Wrap"
                 Foreground="{StaticResource Text}" FontSize="12"/>
    </Border>

    <!-- 動作列 -->
    <Border Grid.Row="3" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
            Padding="20,12" Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="footnoteText" Grid.Column="0"
                   Style="{StaticResource Help}" Margin="0"
                   VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="cancelButton" Content="關閉"
                  Style="{StaticResource SecondaryButton}"/>
          <Button x:Name="secondaryButton" Content=""
                  Style="{StaticResource SecondaryButton}"
                  Visibility="Collapsed"/>
          <Button x:Name="runButton" Content="執行"
                  Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
