<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="window"
        Title="材質管理 — RevitMCP"
        Width="1320" Height="820" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6F8"
        FontFamily="Segoe UI, Microsoft JhengHei"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#255783" />
        <SolidColorBrush x:Key="BrandDarkBrush" Color="#183B58" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F3F6F8" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D7E0E6" />
        <Style x:Key="MainTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#DDEAF3" />
            <Setter Property="Background" Value="#1F4C72" />
            <Setter Property="BorderBrush" Value="#4D7595" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#183B58" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#35698F" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="tabBorder" Property="Background" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="#1F4C72" BorderBrush="#163A58" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <Border Grid.Row="1" Background="{StaticResource CanvasBrush}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandBrush}" Padding="16,8">
            <Grid>
                <StackPanel>
                    <TextBlock Text="材質管理" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="在同一個視窗反查使用、安全批次編輯，並核對房間材質。"
                               Foreground="#DDEAF3" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#DDEAF3" Text="RevitMCP  ·  Material workspace" />
            </Grid>
        </Border>

        <TabControl x:Name="mainTabs" Grid.Row="1" Grid.RowSpan="2"
                    Style="{StaticResource MainTabControlStyle}"
                    ItemContainerStyle="{StaticResource MainTabStyle}" Padding="0">
            <TabItem x:Name="reverseTab" Header="材質反查">
                <ContentControl x:Name="reverseHost" />
            </TabItem>
            <TabItem x:Name="batchTab" Header="材質批次編輯">
                <ContentControl x:Name="batchHost" />
            </TabItem>
            <TabItem x:Name="roomTab" Header="房間材質明細">
                <ContentControl x:Name="roomHost" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
