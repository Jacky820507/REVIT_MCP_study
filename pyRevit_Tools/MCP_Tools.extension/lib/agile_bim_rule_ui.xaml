<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Agile BIM 規則設定"
    Width="1000"
    Height="760"
    MinWidth="860"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="GridBorderBrush" Color="#D3DCE6"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#EAF2F8"/>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="MinHeight" Value="29"/>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="16,13" Margin="0,0,0,14"
            Background="#F3F6FA" BorderBrush="#D8E0EA" BorderThickness="1"
            CornerRadius="4">
      <StackPanel>
        <TextBlock x:Name="windowTitleText" FontSize="19"
                   FontWeight="SemiBold" Text="Agile BIM 規則設定"/>
        <TextBlock Margin="0,5,0,0" Foreground="#52606D"
                   TextWrapping="Wrap"
                   Text="像填 Excel 表格一樣設定規則。這裡只準備 Preview；確認後才會由下一步寫入 Revit。JSON 是進階匯入，不是必要條件。"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <GroupBox Header="1. 規則來源" Padding="12" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="第一次使用請選內建預設" FontWeight="SemiBold"/>
            <ComboBox x:Name="sourceCombo" Margin="0,8,0,0"/>
            <TextBlock x:Name="sourceHintText" Margin="0,7,0,0"
                       FontSize="11" Foreground="#667788"
                       TextWrapping="Wrap"/>
            <Button x:Name="loadJsonButton" Margin="0,10,0,0"
                    Padding="10,6" Content="載入 JSON 規則檔（進階）"
                    IsEnabled="False"/>
          </StackPanel>
        </GroupBox>

        <GroupBox x:Name="settingsPanel" Header="2. 寫入設定" Padding="12">
          <StackPanel>
            <TextBlock Text="要寫入哪個 Revit 文字參數？" Margin="0,0,0,5"/>
            <TextBox x:Name="targetParameterBox" MinHeight="29"
                     ToolTip="例如：房間分類、Door Specification、Wall Performance"/>
            <TextBlock Text="拿哪個欄位來比對？" Margin="0,12,0,5"/>
            <ComboBox x:Name="matchFieldCombo"/>
            <StackPanel x:Name="sourceParameterPanel" Margin="0,10,0,0"
                        Visibility="Collapsed">
              <TextBlock Text="自訂來源參數名稱" Margin="0,0,0,5"/>
              <TextBox x:Name="sourceParameterBox" MinHeight="29"
                       ToolTip="例如：房間用途、區域代碼或其他專案參數"/>
            </StackPanel>

            <StackPanel x:Name="targetScopePanel" Margin="0,12,0,0">
              <TextBlock Text="寫入範圍" Margin="0,0,0,5"/>
              <ComboBox x:Name="targetScopeCombo"/>
            </StackPanel>

            <TextBlock Text="寫入模式" Margin="0,12,0,5"/>
            <ComboBox x:Name="modeCombo"/>

            <CheckBox x:Name="caseInsensitiveCheck" Margin="0,12,0,0"
                      Content="忽略英文字母大小寫"/>
            <CheckBox x:Name="collapseWhitespaceCheck" Margin="0,7,0,0"
                      Content="自動整理多餘空白"/>
            <CheckBox x:Name="extraCheck" Margin="0,7,0,0"
                      Visibility="Collapsed"/>
          </StackPanel>
        </GroupBox>
      </StackPanel>

      <GroupBox Grid.Column="2"
                Header="3. 規則表格（直接修改「找尋文字」與「寫入值」）"
                Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Margin="0,0,0,9"
                     Foreground="#52606D" TextWrapping="Wrap"
                     Text="每一列就是一條規則：來源文字命中後，將右欄的值寫入目標參數。內建預設會顯示在這裡；選擇「可編輯」後可直接改值。"/>

          <Border Grid.Row="1" Background="#EAF2F8"
                  BorderBrush="#D3DCE6" BorderThickness="1,1,1,0">
            <Grid Height="30">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="#" FontWeight="SemiBold"
                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="找尋文字（來源欄位包含此文字）"
                         FontWeight="SemiBold" VerticalAlignment="Center"
                         Margin="8,0,0,0"/>
              <TextBlock Grid.Column="2" Text="寫入值（命中後寫入）"
                         FontWeight="SemiBold" VerticalAlignment="Center"
                         Margin="8,0,0,0"/>
            </Grid>
          </Border>

          <ScrollViewer x:Name="rulesScroll" Grid.Row="2"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        BorderBrush="#D3DCE6" BorderThickness="1,0,1,1">
            <StackPanel x:Name="rulesPanel"/>
          </ScrollViewer>

          <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,6,0,0"
                       Foreground="#667788"
                       Text="需要更多條件？按右側按鈕新增一列。"/>
            <Button x:Name="addRuleButton" Grid.Column="1"
                    Padding="12,6" Content="＋ 新增一列"/>
          </Grid>
        </Grid>
      </GroupBox>
    </Grid>

    <Border Grid.Row="2" Margin="0,14,0,0" Padding="13,10"
            Background="#F8FAFC" BorderBrush="#D8E0EA"
            BorderThickness="1" CornerRadius="4">
      <TextBlock x:Name="statusText" Foreground="#B3261E"
                 TextWrapping="Wrap"
                 Text="請完成設定。"/>
    </Border>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Margin="0,7,16,0"
                 Foreground="#667788" TextWrapping="Wrap"
                 Text="預覽不會修改模型；Preview 完成後才會詢問是否套用。"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="cancelButton" MinWidth="82" Margin="0,0,8,0"
                Padding="14,7" Content="取消"/>
        <Button x:Name="previewButton" MinWidth="190" Padding="14,7"
                IsDefault="True" IsEnabled="False"
                Content="預覽規則（不修改模型）"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
